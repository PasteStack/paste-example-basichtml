# Response headers for hosts that read a _headers file (Cloudflare Pages,
# Netlify). Other static hosts ignore it; set the same headers there.

# Compiled CSS and JS are named by content hash: a change is a new URL.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Third-party files carry their version in the name.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Images never change once published.manifest lists them.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
